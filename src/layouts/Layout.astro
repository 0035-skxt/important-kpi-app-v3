---
import AppNav from '../components/AppNav.astro';
import { withBase } from '../lib/base-url';
import '../styles/global.css';

type Props = {
	/** メイン領域をウィンドウいっぱいに広げる。トップページの分割表示用 */
	fill?: boolean;
};

const { fill = false } = Astro.props;

const appTitle = '重要指標ダッシュボード';
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
		<link rel="icon" href={withBase('favicon.ico')} />
		<meta name="generator" content={Astro.generator} />
		<title>{appTitle}</title>
	</head>
	<body>
		<AppNav />

		<div class="app-chrome app-chrome--header" tabindex="0" aria-label="ヘッダーを表示">
			<header class="app-header">
				<div class="app-header__inner">
					<a class="app-title" href={withBase('')} aria-label="全体画面へ戻る">{appTitle}</a>
				</div>
			</header>
		</div>

		<main class:list={['app-main', 'quiet-scroll', { 'app-main--fill': fill }]}>
			<slot />
		</main>

		<div class="app-chrome app-chrome--footer">
			<footer class="app-footer">
				<small>院内確認用</small>
			</footer>
		</div>
		<script>
			// スクロール中だけ .is-scrolling を付ける。止まってしばらくしたら外す。
			// scroll はバブリングしないため、キャプチャ段階で拾って全領域を1つで賄う。
			const HIDE_DELAY_MS = 800;
			const timers = new WeakMap<Element, number>();

			document.addEventListener(
				'scroll',
				(event) => {
					const target = event.target;
					if (!(target instanceof Element) || !target.classList.contains('quiet-scroll')) {
						return;
					}

					target.classList.add('is-scrolling');
					clearTimeout(timers.get(target));
					timers.set(
						target,
						window.setTimeout(() => target.classList.remove('is-scrolling'), HIDE_DELAY_MS),
					);
				},
				true,
			);
		</script>
	</body>
</html>

<style>
	/* --app-* の定義は src/styles/global.css の :root にある */

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		font-family:
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			'Segoe UI',
			sans-serif;
		color: #0a0a0a;
		background: #fafafa;
		overflow: hidden;
	}

	/* 左端のメニュー帯とは重ならない。帯を畳んだ画面では変数が 0 になり左端まで戻る */
	.app-chrome {
		position: fixed;
		right: 0;
		left: var(--app-sidebar-width);
		z-index: 10;
		box-sizing: border-box;
	}

	.app-chrome--header {
		top: 0;
		height: var(--app-header-height);
	}

	.app-chrome--footer {
		bottom: 0;
		height: var(--app-footer-frame-height);
	}

	.app-chrome:focus-visible {
		outline: 2px solid #0a0a0a;
		outline-offset: -2px;
	}

	.app-header,
	.app-footer {
		position: fixed;
		right: 0;
		left: var(--app-sidebar-width);
		box-sizing: border-box;
		background: rgba(250, 250, 250, 0.96);
		backdrop-filter: blur(8px);
		transition: opacity 160ms ease;
		pointer-events: none;
	}

	.app-header {
		top: 0;
		height: var(--app-header-height);
		opacity: 0;
	}

	.app-header__inner {
		display: flex;
		align-items: center;
		height: var(--app-header-height);
		padding: 0 var(--app-header-height);
	}

	.app-title {
		margin: 0;
		color: inherit;
		font-size: 16px;
		font-weight: 700;
		line-height: 1.2;
		text-decoration: none;
	}

	.app-title:focus-visible {
		outline: 2px solid #0a0a0a;
		outline-offset: 4px;
	}

	.app-main {
		position: fixed;
		top: var(--app-header-height);
		right: 0;
		bottom: var(--app-footer-frame-height);
		left: var(--app-sidebar-width);
		box-sizing: border-box;
		overflow: auto;
		overscroll-behavior: contain;
	}

	.app-footer {
		bottom: 0;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		height: var(--app-footer-height);
		padding: 0 var(--app-content-padding);
		color: #526070;
		font-size: 12px;
		opacity: 0;
	}

	/*
	 * 広い画面でだけメイン領域をウィンドウいっぱいに広げる。
	 * 枠はここが一手に持つ。中身(PanelGrid等)は四辺の余白を足さないこと。
	 * 両方が持つと上下だけ二重になり、左右と揃わなくなる。
	 */
	@media (min-width: 1024px) {
		.app-main--fill {
			top: 0;
			bottom: 0;
			padding: var(--app-frame);
			overflow: hidden;
		}
	}

	.app-chrome--header:hover .app-header,
	.app-chrome--header:focus .app-header,
	.app-chrome--header:focus-within .app-header,
	.app-chrome--footer:hover .app-footer {
		opacity: 1;
		pointer-events: auto;
	}

	/*
	 * タッチ端末には hover が無く、隠れたヘッダー/フッターに到達できない。
	 * 掲示のように「操作しない前提で余計なUIを消す」意味も無いので常時表示する。
	 */
	@media (hover: none) {
		.app-header,
		.app-footer {
			opacity: 1;
			pointer-events: auto;
		}
	}

	/* 帯幅の 0 化は global.css 側 */
	@media (max-width: 600px) {
		/* 帯が無い画面ではメニューボタンが唯一の入口になる。ヘッダーは隠さない */
		.app-header {
			opacity: 1;
			pointer-events: auto;
		}

		/* 左上のメニューボタンとタイトルを重ねない */
		.app-header__inner {
			padding: 0 var(--app-content-padding) 0 calc(var(--app-header-height) + 4px);
		}
	}
</style>
