---
import FacilityKpiBoard from '../components/FacilityKpiBoard.astro';
import FacilityKpiDataLoader from '../components/FacilityKpiDataLoader.astro';
import FacilityKpiPreparationBoard from '../components/FacilityKpiPreparationBoard.astro';
import PanelGrid from '../components/PanelGrid.astro';
import Layout from '../layouts/Layout.astro';
import { kyoritsuBoardItems, rehaBoardItems } from '../lib/facility-board';
---

<Layout fill>
	<PanelGrid split={4}>
		<FacilityKpiBoard sourceId="kyoritsu" label="戸畑共立病院" items={kyoritsuBoardItems} href="kyoritsu" />
		<FacilityKpiBoard sourceId="reha" label="戸畑リハビリテーション病院" items={rehaBoardItems} href="reha" />
		<FacilityKpiPreparationBoard label="あやめの里" />
		<FacilityKpiPreparationBoard label="明治町クリニック" />
	</PanelGrid>

	<FacilityKpiDataLoader />
</Layout>
