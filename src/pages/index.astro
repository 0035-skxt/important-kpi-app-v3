---
import Layout from '../layouts/Layout.astro';

const DATA_FIELD = {
	DATE: "日付",
	BED_USAGE: "病床利用率 (%)",
	AMBULANCE_TRANSPORT: "救急車搬入数",
	EXCEPTED_IMPATIENT: "入院患者数",
	EXCEPTED_DISCHARGES: "退院予定数",
	GENERAL_INPATIENT: "一般病棟在院数",
	ICU_IMPATIENT: "集中治療室在院数",
	AVERAGE_STAY: "平均在院日数",
	SURGERIES: "手術件数",
	LONG_TERM_INPATIENTS: "長期入院者数（30日）",
} as const;

---

<Layout>
	<main class="page">
		<section class="kpi" aria-live="polite">
			<p class="label">戸畑共立病院</p>
			<h1>病床利用率</h1>
			<p id="bed-usage" class="value">取得中...</p>
			<p id="target-date" class="date">日付: --</p>
			<p id="status" class="status">APIから最新データを取得しています</p>

			<h3>救急車搬入数</h3>
			<p id="ambulance-transport">取得中...</p>
			<h3>入院患者数</h3>
			<p id="excepted-impatient">取得中...</p>
			<h3>退院予定数</h3>
			<p id="excepted-discharges">取得中...</p>
			<h3>一般病棟在院数</h3>
			<p id="general-inpatient">取得中...</p>
			<h3>集中治療室在院数</h3>
			<p id="icu-impatient">取得中...</p>
			<h3>平均在院日数</h3>
			<p id="average-stay">取得中...</p>
			<h3>手術件数</h3>
			<p id="surgeries">取得中...</p>
			<h3>長期入院者数（30日）</h3>
			<p id="long-term-inpatients">取得中...</p>
		</section>
	</main>

	<script define:vars={{ DATA_FIELD }}>

		const API_URL =
			'https://script.google.com/macros/s/AKfycbwor8y2k5p2zXUcIj7rBnyn3Z_V4cTyEgcyGzGnvy_VgAjam2ymmMFJNy0xUvnTuzjt/exec';

		// id / APIのフィールド名 / 表示整形方法をひとまとめにする。
		// KPIが増えたらここに1行足すだけでよい。
		const KPI_CONFIGS = [
			{ id: 'bed-usage', field: DATA_FIELD.BED_USAGE, format: (v) => `${(v * 100).toFixed(1)}%` },
			{ id: 'ambulance-transport', field: DATA_FIELD.AMBULANCE_TRANSPORT },
			{ id: 'excepted-impatient', field: DATA_FIELD.EXCEPTED_IMPATIENT },
			{ id: 'excepted-discharges', field: DATA_FIELD.EXCEPTED_DISCHARGES },
			{ id: 'general-inpatient', field: DATA_FIELD.GENERAL_INPATIENT },
			{ id: 'icu-impatient', field: DATA_FIELD.ICU_IMPATIENT },
			{ id: 'average-stay', field: DATA_FIELD.AVERAGE_STAY },
			{ id: 'surgeries', field: DATA_FIELD.SURGERIES },
			{ id: 'long-term-inpatients', field: DATA_FIELD.LONG_TERM_INPATIENTS },
		];

		const dateElement = document.querySelector('#target-date');
		const statusElement = document.querySelector('#status');

		async function fetchLatestData() {
			const response = await fetch(API_URL);

			if (!response.ok) {
				throw new Error('API request failed');
			}

			const payload = await response.json();
			const rows = payload.data;

			if (!Array.isArray(rows) || rows.length === 0) {
				throw new Error('No data rows');
			}

			return rows[rows.length - 1];
		}

		function setValue(id, text) {
			const el = document.getElementById(id);
			if (el) {
				el.textContent = text;
			}
		}

		// APIの日付はUTCのISO文字列（例: "2025-01-31T15:00:00.000Z"）で返る。
		// スプレッドシートのタイムゾーン（Asia/Tokyo）で見た本来の日付に戻すため、
		// タイムゾーンを明示してフォーマットする（ブラウザのTZ任せにしない）。
		function formatDate(value) {
			const date = new Date(value);
			if (Number.isNaN(date.getTime())) {
				return null;
			}
			return date.toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' });
		}

		function renderKpis(latest) {
			for (const { id, field, format } of KPI_CONFIGS) {
				const raw = latest[field];
				setValue(id, raw != null && raw !== '' ? (format ? format(raw) : String(raw)) : '--');
			}

			dateElement.textContent = `日付: ${formatDate(latest[DATA_FIELD.DATE]) ?? '--'}`;
			statusElement.textContent = '最新データを表示しています';
		}

		function renderError() {
			for (const { id } of KPI_CONFIGS) {
				setValue(id, '--');
			}

			dateElement.textContent = '日付: --';
			statusElement.textContent = 'データを取得できませんでした';
		}

		async function loadKpis() {
			try {
				const latest = await fetchLatestData();
				renderKpis(latest);
			} catch (error) {
				console.error('KPI fetch/render failed:', error);
				renderError();
			}
		}

		loadKpis();
	</script>
</Layout>

<style>
	:global(body) {
		font-family:
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			'Segoe UI',
			sans-serif;
		color: #172033;
		background: #f7f9fb;
	}

	.page {
		box-sizing: border-box;
		min-height: 100vh;
		display: grid;
		place-items: center;
		padding: 24px;
	}

	.kpi {
		text-align: center;
	}

	.label,
	.date,
	.status {
		margin: 0;
		color: #526070;
	}

	.label {
		font-size: 18px;
		font-weight: 700;
	}

	h1 {
		margin: 12px 0 0;
		font-size: 32px;
		line-height: 1.2;
	}

	.value {
		margin: 24px 0;
		font-size: clamp(64px, 16vw, 160px);
		font-weight: 800;
		line-height: 1;
	}

	.date {
		font-size: 16px;
	}

	.status {
		margin-top: 8px;
		font-size: 14px;
	}
</style>
