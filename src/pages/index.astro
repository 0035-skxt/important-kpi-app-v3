---
import FacilityKpiBoard from '../components/FacilityKpiBoard.astro';
import FacilityKpiDataLoader from '../components/FacilityKpiDataLoader.astro';
import Layout from '../layouts/Layout.astro';
import { kyoritsuBoardItems, rehaBoardItems } from '../lib/facility-board-items';
---

<Layout>
	<div class="page">
		<div class="layout">
			<FacilityKpiBoard
				label="戸畑共立病院"
				items={kyoritsuBoardItems}
				dateId="kyoritsu-target-date"
				statusId="kyoritsu-status"
				href="kyoritsu"
			/>

			<FacilityKpiBoard
				label="戸畑リハビリテーション病院"
				items={rehaBoardItems}
				dateId="reha-target-date"
				statusId="reha-status"
				href="reha"
			/>
		</div>
	</div>

	<FacilityKpiDataLoader />
</Layout>

<style>
	.page {
		box-sizing: border-box;
		min-height: 100%;
	}

	.layout {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: start;
		gap: 24px;
		padding: 0 var(--app-header-height) var(--app-content-padding);
	}

	@media (max-width: 760px) {
		.layout {
			grid-template-columns: 1fr;
			gap: 16px;
		}
	}
</style>
