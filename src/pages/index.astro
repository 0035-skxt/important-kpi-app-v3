---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="page">

		<header class="header">
			<h1>重要指標ダッシュボード</h1>
		</header>

		<div class="layout">

			<section class="kpi" aria-live="polite">
				<h1 class="label">戸畑共立病院</h1>

				<dl class="kpi-grid">
					<div class="kpi-row">
						<dt>病床利用率</dt>
						<dd id="kyoritsu-bed-usage" class="value">取得中...</dd>
						<svg
							id="kyoritsu-bed-usage-chart"
							class="trend-chart"
							viewBox="0 0 320 120"
							preserveAspectRatio="xMidYMid meet"
							role="img"
							aria-label="病床利用率の14日間推移グラフ"
						></svg>
					</div>

					<div class="kpi-row">
						<dt>救急車搬入数</dt>
						<dd id="kyoritsu-ambulance-transport">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>入院患者数</dt>
						<dd id="kyoritsu-excepted-impatient">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>退院予定数</dt>
						<dd id="kyoritsu-excepted-discharges">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>一般病棟在院数</dt>
						<dd id="kyoritsu-general-inpatient">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>集中治療室在院数</dt>
						<dd id="kyoritsu-icu-impatient">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>平均在院日数</dt>
						<dd id="kyoritsu-average-stay">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>手術件数</dt>
						<dd id="kyoritsu-surgeries">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>長期入院者数（30日）</dt>
						<dd id="kyoritsu-long-term-inpatients">取得中...</dd>
					</div>
				</dl>

				<p id="kyoritsu-target-date" class="date">日付: --</p>
				<p id="kyoritsu-status" class="status">APIから最新データを取得しています</p>
			</section>

			<section class="kpi" aria-live="polite">
				<h1 class="label">戸畑リハビリテーション病院</h1>

				<dl class="kpi-grid">
					<div class="kpi-row">
						<dt>病床利用率</dt>
						<dd id="reha-bed-usage" class="value">取得中...</dd>
						<svg
							id="reha-bed-usage-chart"
							class="trend-chart"
							viewBox="0 0 320 120"
							preserveAspectRatio="xMidYMid meet"
							role="img"
							aria-label="病床利用率の14日間推移グラフ"
						></svg>
					</div>

					<div class="kpi-row">
						<dt>在院数</dt>
						<dd id="reha-inpatient">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>入院患者数</dt>
						<dd id="reha-excepted-impatient">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>退院予定数</dt>
						<dd id="reha-excepted-discharges">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>平均在院日数</dt>
						<dd id="reha-average-stay">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>地域包括ケア在院数</dt>
						<dd id="reha-community-inpatient">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>地域包括ケア平均在院日数</dt>
						<dd id="reha-community-average-stay">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>回復期在院数</dt>
						<dd id="reha-rehabilitation-inpatient">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>回復期平均在院日数</dt>
						<dd id="reha-rehabilitation-average-stay">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>緩和ケア在院数</dt>
						<dd id="reha-palliative-inpatient">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>緩和ケア平均在院日数</dt>
						<dd id="reha-palliative-average-stay">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>2階北在院数</dt>
						<dd id="reha-floor-2-north-inpatient">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>2階北平均在院日数</dt>
						<dd id="reha-floor-2-north-average-stay">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>2階南在院数</dt>
						<dd id="reha-floor-2-south-inpatient">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>2階南平均在院日数</dt>
						<dd id="reha-floor-2-south-average-stay">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>3階在院数</dt>
						<dd id="reha-floor-3-inpatient">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>3階平均在院日数</dt>
						<dd id="reha-floor-3-average-stay">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>4階在院数</dt>
						<dd id="reha-floor-4-inpatient">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>4階北平均在院日数</dt>
						<dd id="reha-floor-4-north-average-stay">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>5階在院数</dt>
						<dd id="reha-floor-5-inpatient">取得中...</dd>
					</div>

					<div class="kpi-row">
						<dt>5階平均在院日数</dt>
						<dd id="reha-floor-5-average-stay">取得中...</dd>
					</div>
				</dl>

				<p id="reha-target-date" class="date">日付: --</p>
				<p id="reha-status" class="status">APIから最新データを取得しています</p>
			</section>
		</div>
	</main>

	<script type="module">
		import { select, scalePoint, scaleLinear, extent, line } from 'd3';

		const DATA_FIELD_KYORITSU = {
			DATE: '日付',
			BED_USAGE: '病床利用率 (%)',
			AMBULANCE_TRANSPORT: '救急車搬入数',
			EXCEPTED_IMPATIENT: '入院患者数',
			EXCEPTED_DISCHARGES: '退院予定数',
			GENERAL_INPATIENT: '一般病棟在院数',
			ICU_IMPATIENT: '集中治療室在院数',
			AVERAGE_STAY: '平均在院日数',
			SURGERIES: '手術件数',
			LONG_TERM_INPATIENTS: '長期入院者数（30日）',
		};

		const DATA_FIELD_REHA = {
			BED_USAGE: '病床利用率',
			INPATIENT: '在院数',
			EXCEPTED_IMPATIENT: '入院患者数',
			EXCEPTED_DISCHARGES: '退院予定数',
			AVERAGE_STAY: '平均在院日数',
			COMMUNITY_INPATIENT: '地域包括ケア在院数',
			COMMUNITY_AVERAGE_STAY: '地域包括ケア平均在院日数',
			REHABILITATION_INPATIENT: '回復期在院数',
			REHABILITATION_AVERAGE_STAY: '回復期平均在院日数',
			PALLIATIVE_INPATIENT: '緩和ケア在院数',
			PALLIATIVE_AVERAGE_STAY: '緩和ケア平均在院日数',
			FLOOR_2_NORTH_INPATIENT: '2階北在院数',
			FLOOR_2_NORTH_AVERAGE_STAY: '2階北平均在院日数',
			FLOOR_2_SOUTH_INPATIENT: '2階南在院数',
			FLOOR_2_SOUTH_AVERAGE_STAY: '2階南平均在院日数',
			FLOOR_3_INPATIENT: '3階在院数',
			FLOOR_3_AVERAGE_STAY: '3階平均在院日数',
			FLOOR_4_INPATIENT: '4階在院数',
			FLOOR_4_NORTH_AVERAGE_STAY: '4階北平均在院日数',
			FLOOR_5_INPATIENT: '5階在院数',
			FLOOR_5_AVERAGE_STAY: '5階平均在院日数',
		};

		const TREND_DAYS = 14;

		const API_URL_KYORITSU =
			'https://script.google.com/macros/s/AKfycbwor8y2k5p2zXUcIj7rBnyn3Z_V4cTyEgcyGzGnvy_VgAjam2ymmMFJNy0xUvnTuzjt/exec';
		const API_URL_REHA = 'https://script.google.com/macros/s/AKfycbyEBYJ6M-RXFpsFQPagf1mF1kR5ldRxT3eYi78QisCFx96hsNnPWa3rULAY7naiZq0/exec';
		const REHA_RESPONSE_FIELD = {
			DATE: 'date',
			PATH: 'path',
			LABEL: 'display_name',
			VALUE: 'value',
		};


		// id / APIのフィールド名 / 表示整形方法をひとまとめにする。
		// KPIが増えたらここに1行足すだけでよい。
		const KPI_CONFIGS_KYORITSU = [
			{ id: 'kyoritsu-bed-usage', field: DATA_FIELD_KYORITSU.BED_USAGE, format: (v) => `${(v * 100).toFixed(1)}%` },
			{ id: 'kyoritsu-ambulance-transport', field: DATA_FIELD_KYORITSU.AMBULANCE_TRANSPORT },
			{ id: 'kyoritsu-excepted-impatient', field: DATA_FIELD_KYORITSU.EXCEPTED_IMPATIENT },
			{ id: 'kyoritsu-excepted-discharges', field: DATA_FIELD_KYORITSU.EXCEPTED_DISCHARGES },
			{ id: 'kyoritsu-general-inpatient', field: DATA_FIELD_KYORITSU.GENERAL_INPATIENT },
			{ id: 'kyoritsu-icu-impatient', field: DATA_FIELD_KYORITSU.ICU_IMPATIENT },
			{ id: 'kyoritsu-average-stay', field: DATA_FIELD_KYORITSU.AVERAGE_STAY },
			{ id: 'kyoritsu-surgeries', field: DATA_FIELD_KYORITSU.SURGERIES },
			{ id: 'kyoritsu-long-term-inpatients', field: DATA_FIELD_KYORITSU.LONG_TERM_INPATIENTS },
		];

		const KPI_CONFIGS_REHA = [
			{ id: 'reha-bed-usage', path: '/reha', label: DATA_FIELD_REHA.BED_USAGE, format: (v) => `${(v * 100).toFixed(1)}%` },
			{ id: 'reha-inpatient', path: '/reha', label: DATA_FIELD_REHA.INPATIENT },
			{ id: 'reha-excepted-impatient', path: '/reha', label: DATA_FIELD_REHA.EXCEPTED_IMPATIENT },
			{ id: 'reha-excepted-discharges', path: '/reha', label: DATA_FIELD_REHA.EXCEPTED_DISCHARGES },
			{ id: 'reha-average-stay', path: 'reha', label: DATA_FIELD_REHA.AVERAGE_STAY },
			{ id: 'reha-community-inpatient', path: '/reha/community', label: DATA_FIELD_REHA.COMMUNITY_INPATIENT },
			{ id: 'reha-community-average-stay', path: '/reha/community', label: DATA_FIELD_REHA.COMMUNITY_AVERAGE_STAY },
			{ id: 'reha-rehabilitation-inpatient', path: '/reha/rehabilitation', label: DATA_FIELD_REHA.REHABILITATION_INPATIENT },
			{ id: 'reha-rehabilitation-average-stay', path: '/reha/rehabilitation', label: DATA_FIELD_REHA.REHABILITATION_AVERAGE_STAY },
			{ id: 'reha-palliative-inpatient', path: '/reha/palliative', label: DATA_FIELD_REHA.PALLIATIVE_INPATIENT },
			{ id: 'reha-palliative-average-stay', path: '/reha/palliative', label: DATA_FIELD_REHA.PALLIATIVE_AVERAGE_STAY },
			{ id: 'reha-floor-2-north-inpatient', path: '/reha/f2n', label: DATA_FIELD_REHA.FLOOR_2_NORTH_INPATIENT },
			{ id: 'reha-floor-2-north-average-stay', path: '/reha/f2n', label: DATA_FIELD_REHA.FLOOR_2_NORTH_AVERAGE_STAY },
			{ id: 'reha-floor-2-south-inpatient', path: '/reha/f2s', label: DATA_FIELD_REHA.FLOOR_2_SOUTH_INPATIENT },
			{ id: 'reha-floor-2-south-average-stay', path: '/reha/f2s', label: DATA_FIELD_REHA.FLOOR_2_SOUTH_AVERAGE_STAY },
			{ id: 'reha-floor-3-inpatient', path: '/reha/f3', label: DATA_FIELD_REHA.FLOOR_3_INPATIENT },
			{ id: 'reha-floor-3-average-stay', path: '/reha/f3', label: DATA_FIELD_REHA.FLOOR_3_AVERAGE_STAY },
			{ id: 'reha-floor-4-inpatient', path: '/reha/f4', label: DATA_FIELD_REHA.FLOOR_4_INPATIENT },
			{ id: 'reha-floor-4-north-average-stay', path: '/reha/f4', label: DATA_FIELD_REHA.FLOOR_4_NORTH_AVERAGE_STAY },
			{ id: 'reha-floor-5-inpatient', path: '/reha/f5', label: DATA_FIELD_REHA.FLOOR_5_INPATIENT },
			{ id: 'reha-floor-5-average-stay', path: '/reha/f5', label: DATA_FIELD_REHA.FLOOR_5_AVERAGE_STAY },
		];

		const kyoritsuDateElement = document.querySelector('#kyoritsu-target-date');
		const kyoritsuStatusElement = document.querySelector('#kyoritsu-status');
		const rehaDateElement = document.querySelector('#reha-target-date');
		const rehaStatusElement = document.querySelector('#reha-status');

		// 行配列を返す取得処理と、そこから用途別（直近1件 / 直近14日分）に
		// 整形する処理を分離する。両方の用途で同じAPIレスポンスを使い回すため。
		async function fetchKyoritsuRows() {
			const response = await fetch(API_URL_KYORITSU);

			if (!response.ok) {
				throw new Error('API request failed');
			}

			const payload = await response.json();
			const rows = payload.data;

			if (!Array.isArray(rows) || rows.length === 0) {
				throw new Error('No data rows');
			}

			return rows;
		}

		function getLatestKyoritsuRow(rows) {
			return rows[rows.length - 1];
		}

		async function fetchRehaRows() {
			const response = await fetch(API_URL_REHA);

			if (!response.ok) {
				throw new Error('Reha API request failed');
			}

			const payload = await response.json();
			const rows = payload.data;

			if (!Array.isArray(rows) || rows.length === 0) {
				throw new Error('No reha data rows');
			}

			return rows;
		}

		function getLatestRehaDate(rows) {
			return rows.reduce((latest, row) => {
				const date = row[REHA_RESPONSE_FIELD.DATE];
				return typeof date === 'string' && date > latest ? date : latest;
			}, '');
		}

		function getLatestRehaRows(rows) {
			const latestDate = getLatestRehaDate(rows);

			return {
				date: latestDate,
				rows: rows.filter((row) => row[REHA_RESPONSE_FIELD.DATE] === latestDate),
			};
		}

		// APIの日付（UTC ISO文字列）をAsia/Tokyoの暦日（YYYY-MM-DD）に変換する。
		// sv-SEロケールはYYYY-MM-DD形式を返すため、ここではその副作用を利用する。
		function toTokyoDateKey(value) {
			const date = new Date(value);
			if (Number.isNaN(date.getTime())) {
				return null;
			}
			return new Intl.DateTimeFormat('sv-SE', { timeZone: 'Asia/Tokyo' }).format(date);
		}

		// 最新日を含む直近days日分の暦日を作り、値が無い日はnullのまま残す。
		// 前日値での補間や0埋めはせず、「データなし」を後段の描画で明示するため。
		function buildDailySeries(latestDateKey, days, valueByDate) {
			if (!latestDateKey) {
				return [];
			}

			const series = [];
			const base = new Date(`${latestDateKey}T00:00:00Z`);

			for (let i = days - 1; i >= 0; i -= 1) {
				const d = new Date(base);
				d.setUTCDate(d.getUTCDate() - i);
				const key = d.toISOString().slice(0, 10);
				series.push({ date: key, value: valueByDate.has(key) ? valueByDate.get(key) : null });
			}

			return series;
		}

		function getKyoritsuBedUsageSeries(rows, days = TREND_DAYS) {
			const byDate = new Map();
			for (const row of rows) {
				const key = toTokyoDateKey(row[DATA_FIELD_KYORITSU.DATE]);
				if (key) {
					byDate.set(key, row[DATA_FIELD_KYORITSU.BED_USAGE]);
				}
			}

			const latestKey = toTokyoDateKey(getLatestKyoritsuRow(rows)[DATA_FIELD_KYORITSU.DATE]);
			return buildDailySeries(latestKey, days, byDate);
		}

		function getRehaBedUsageSeries(rows, days = TREND_DAYS) {
			const byDate = new Map();
			for (const row of rows) {
				if (row[REHA_RESPONSE_FIELD.PATH] === '/reha' && row[REHA_RESPONSE_FIELD.LABEL] === DATA_FIELD_REHA.BED_USAGE) {
					byDate.set(row[REHA_RESPONSE_FIELD.DATE], row[REHA_RESPONSE_FIELD.VALUE]);
				}
			}

			return buildDailySeries(getLatestRehaDate(rows), days, byDate);
		}

		function setKyoritsuValue(id, text) {
			const el = document.getElementById(id);
			if (el) {
				el.textContent = text;
			}
		}

		function setRehaValue(id, text) {
			const el = document.getElementById(id);
			if (el) {
				el.textContent = text;
			}
		}

		// APIの日付はUTCのISO文字列（例: "2025-01-31T15:00:00.000Z"）で返る。
		// スプレッドシートのタイムゾーン（Asia/Tokyo）で見た本来の日付に戻すため、
		// タイムゾーンを明示してフォーマットする（ブラウザのTZ任せにしない）。
		function formatDate(value) {
			const date = new Date(value);
			if (Number.isNaN(date.getTime())) {
				return null;
			}
			return date.toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' });
		}

		function renderKyoritsuKpis(latest) {
			for (const { id, field, format } of KPI_CONFIGS_KYORITSU) {
				const raw = latest[field];
				setKyoritsuValue(id, raw != null && raw !== '' ? (format ? format(raw) : String(raw)) : '--');
			}

			if (kyoritsuDateElement) {
				kyoritsuDateElement.textContent = `日付: ${formatDate(latest[DATA_FIELD_KYORITSU.DATE]) ?? '--'}`;
			}
			if (kyoritsuStatusElement) {
				kyoritsuStatusElement.textContent = '最新データを表示しています';
			}
		}

		function renderRehaKpis(latest) {
			for (const { id, path, label, format } of KPI_CONFIGS_REHA) {
				const row = latest.rows.find(
					(row) => row[REHA_RESPONSE_FIELD.PATH] === path && row[REHA_RESPONSE_FIELD.LABEL] === label,
				);
				const raw = row?.[REHA_RESPONSE_FIELD.VALUE];
				setRehaValue(id, raw != null && raw !== '' ? (format ? format(raw) : String(raw)) : '--');
			}

			if (rehaDateElement) {
				rehaDateElement.textContent = `日付: ${latest.date || '--'}`;
			}
			if (rehaStatusElement) {
				rehaStatusElement.textContent = '最新データを表示しています';
			}
		}

		function clearTrendChart(svgId) {
			select(`#${svgId}`).selectAll('*').remove();
		}

		// SVGサイズ・余白・Y軸開始値など、見た目に関わる設定は
		// この1関数に集約し、両施設のグラフで必ず同一になるようにする。
		const TREND_CHART_WIDTH = 320;
		const TREND_CHART_HEIGHT = 120;
		const TREND_CHART_MARGIN = { top: 10, right: 10, bottom: 20, left: 34 };
		const TREND_Y_MIN = 0.6; // 病床利用率のY軸は60%から開始する

		// 施設ごとに実データの上限までスケールする（下限は両施設共通で60%固定）。
		// 欠測日は前日値で補間せず、×印＋title属性で「データなし」と明示する。
		function renderBedUsageTrend(svgId, series) {
			const svg = select(`#${svgId}`);
			svg.selectAll('*').remove();

			const width = TREND_CHART_WIDTH;
			const height = TREND_CHART_HEIGHT;
			const margin = TREND_CHART_MARGIN;
			const innerWidth = width - margin.left - margin.right;
			const innerHeight = height - margin.top - margin.bottom;

			const values = series.map((d) => d.value).filter((v) => v != null);

			if (values.length === 0) {
				svg
					.append('text')
					.attr('class', 'trend-chart-empty')
					.attr('x', width / 2)
					.attr('y', height / 2)
					.attr('text-anchor', 'middle')
					.text('データなし');
				return;
			}

			const maxValue = Math.max(...values);
			const yMax = Math.min(1, Math.max(maxValue + 0.02, TREND_Y_MIN + 0.02));

			const x = scalePoint()
				.domain(series.map((d) => d.date))
				.range([0, innerWidth]);

			const y = scaleLinear().domain([TREND_Y_MIN, yMax]).range([innerHeight, 0]);

			const g = svg.append('g').attr('transform', `translate(${margin.left},${margin.top})`);

			// グリッド線は表示せず、Y軸のラベルとその位置を示す短い目盛りのみ描く。
			const yTicks = y.ticks(3);
			g.selectAll('.trend-y-tick')
				.data(yTicks)
				.join('line')
				.attr('class', 'trend-y-tick')
				.attr('x1', -3)
				.attr('x2', 0)
				.attr('y1', (d) => y(d))
				.attr('y2', (d) => y(d));

			g.selectAll('.trend-y-label')
				.data(yTicks)
				.join('text')
				.attr('class', 'trend-y-label')
				.attr('x', -6)
				.attr('y', (d) => y(d))
				.attr('dominant-baseline', 'middle')
				.attr('text-anchor', 'end')
				.text((d) => `${(d * 100).toFixed(0)}%`);

			const tickDates = series.filter((_, i) => i % 3 === 0 || i === series.length - 1).map((d) => d.date);
			g.selectAll('.trend-x-label')
				.data(tickDates)
				.join('text')
				.attr('class', 'trend-x-label')
				.attr('x', (d) => x(d))
				.attr('y', innerHeight + 14)
				.attr('text-anchor', 'middle')
				.text((d) => {
					const date = new Date(`${d}T00:00:00Z`);
					return `${date.getUTCMonth() + 1}/${date.getUTCDate()}`;
				});

			const lineGenerator = line()
				.defined((d) => d.value != null)
				.x((d) => x(d.date))
				.y((d) => y(d.value));

			g.append('path').datum(series).attr('class', 'trend-line').attr('d', lineGenerator);

			const points = g
				.selectAll('.trend-point')
				.data(series.filter((d) => d.value != null))
				.join('circle')
				.attr('class', 'trend-point')
				.attr('cx', (d) => x(d.date))
				.attr('cy', (d) => y(d.value))
				.attr('r', 3);

			// ツールチップはブラウザ標準のtitle属性（ホバーで日付・値を表示）で対応する。
			points
				.append('title')
				.text((d) => `${formatTrendDate(d.date)}: ${(d.value * 100).toFixed(1)}%`);

			const missing = g
				.selectAll('.trend-missing')
				.data(series.filter((d) => d.value == null))
				.join('g')
				.attr('class', 'trend-missing')
				.attr('transform', (d) => `translate(${x(d.date)},${innerHeight / 2})`);

			missing.append('title').text((d) => `${formatTrendDate(d.date)}: データなし`);
			missing.append('line').attr('x1', -4).attr('y1', -4).attr('x2', 4).attr('y2', 4);
			missing.append('line').attr('x1', -4).attr('y1', 4).attr('x2', 4).attr('y2', -4);
		}

		function formatTrendDate(dateKey) {
			const date = new Date(`${dateKey}T00:00:00Z`);
			return `${date.getUTCMonth() + 1}/${date.getUTCDate()}`;
		}

		function renderKyoritsuError() {
			for (const { id } of KPI_CONFIGS_KYORITSU) {
				setKyoritsuValue(id, '--');
			}

			if (kyoritsuDateElement) {
				kyoritsuDateElement.textContent = '日付: --';
			}
			if (kyoritsuStatusElement) {
				kyoritsuStatusElement.textContent = 'データを取得できませんでした';
			}
			clearTrendChart('kyoritsu-bed-usage-chart');
		}

		function renderRehaError() {
			for (const { id } of KPI_CONFIGS_REHA) {
				setRehaValue(id, '--');
			}

			if (rehaDateElement) {
				rehaDateElement.textContent = '日付: --';
			}
			if (rehaStatusElement) {
				rehaStatusElement.textContent = 'データを取得できませんでした';
			}
			clearTrendChart('reha-bed-usage-chart');
		}

		async function loadKyoritsuKpis() {
			try {
				const rows = await fetchKyoritsuRows();
				renderKyoritsuKpis(getLatestKyoritsuRow(rows));
				renderBedUsageTrend('kyoritsu-bed-usage-chart', getKyoritsuBedUsageSeries(rows));
			} catch (error) {
				console.error('Kyoritsu KPI fetch/render failed:', error);
				renderKyoritsuError();
			}
		}

		async function loadRehaKpis() {
			try {
				const rows = await fetchRehaRows();
				renderRehaKpis(getLatestRehaRows(rows));
				renderBedUsageTrend('reha-bed-usage-chart', getRehaBedUsageSeries(rows));
			} catch (error) {
				console.error('Reha KPI fetch/render failed:', error);
				renderRehaError();
			}
		}

		loadKyoritsuKpis();
		loadRehaKpis();
	</script>
</Layout>

