---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="page">
		<section class="kpi" aria-live="polite">
			<p class="label">戸畑共立病院</p>
			<h1>病床利用率</h1>
			<p id="bed-usage" class="value">取得中...</p>
			<p id="target-date" class="date">日付: --</p>
			<p id="status" class="status">APIから最新データを取得しています</p>
		</section>
	</main>

	<script>

		const API_URL =
			'https://script.google.com/macros/s/AKfycbwor8y2k5p2zXUcIj7rBnyn3Z_V4cTyEgcyGzGnvy_VgAjam2ymmMFJNy0xUvnTuzjt/exec';


		const valueElement = document.querySelector('#bed-usage');
		const dateElement = document.querySelector('#target-date');
		const statusElement = document.querySelector('#status');

		async function loadBedUsage() {
			try {
				const response = await fetch(API_URL);

				if (!response.ok) {
					throw new Error('API request failed');
				}

				const payload = await response.json();
				const rows = payload.data;

				if (!Array.isArray(rows) || rows.length === 0) {
					throw new Error('No data rows');
				}

				const latest = rows[rows.length - 1];
				const usageRate = latest['病床利用率 (%)'] * 100;

				if (!Number.isFinite(usageRate)) {
					throw new Error('Invalid bed usage rate');
				}

				valueElement.textContent = `${usageRate.toFixed(1)}%`;
				dateElement.textContent = `日付: ${latest['日付'] ?? '--'}`;
				statusElement.textContent = '最新データを表示しています';
			} catch (error) {
				valueElement.textContent = '--%';
				dateElement.textContent = '日付: --';
				statusElement.textContent = 'データを取得できませんでした';
			}
		}

		loadBedUsage();
	</script>
</Layout>

<style>
	:global(body) {
		font-family:
			system-ui,
			-apple-system,
			BlinkMacSystemFont,
			'Segoe UI',
			sans-serif;
		color: #172033;
		background: #f7f9fb;
	}

	.page {
		box-sizing: border-box;
		min-height: 100vh;
		display: grid;
		place-items: center;
		padding: 24px;
	}

	.kpi {
		text-align: center;
	}

	.label,
	.date,
	.status {
		margin: 0;
		color: #526070;
	}

	.label {
		font-size: 18px;
		font-weight: 700;
	}

	h1 {
		margin: 12px 0 0;
		font-size: 32px;
		line-height: 1.2;
	}

	.value {
		margin: 24px 0;
		font-size: clamp(64px, 16vw, 160px);
		font-weight: 800;
		line-height: 1;
	}

	.date {
		font-size: 16px;
	}

	.status {
		margin-top: 8px;
		font-size: 14px;
	}
</style>
