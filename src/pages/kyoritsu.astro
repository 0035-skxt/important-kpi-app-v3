---
import FacilityKpiBoard from '../components/FacilityKpiBoard.astro';
import FacilityKpiDataLoader from '../components/FacilityKpiDataLoader.astro';
import Layout from '../layouts/Layout.astro';
import { kyoritsuBoardItems } from '../lib/facility-board';
---

<Layout>
	<div class="page">
		<FacilityKpiBoard sourceId="kyoritsu" label="戸畑共立病院" items={kyoritsuBoardItems} />
	</div>

	<FacilityKpiDataLoader />
</Layout>

<style>
	/*
	 * .page は既定 min-height:100% で、中身に応じて伸びページ全体がスクロールする。
	 * ボードページは見出し/フッターを固定し中央だけ内部スクロールさせたいので、
	 * ここだけ高さを確定させ、FacilityKpiBoard の height:100% を効かせる。
	 */
	.page {
		height: 100%;
	}
</style>
