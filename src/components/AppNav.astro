---
import { withBase } from '../lib/base-url';

/*
 * 画面の左端に置く固定メニュー。分割グリッドの外側に立つ。
 * 狭い画面では幅を持たず、ヘッダー左上のボタンで開く畳み込みに変わる。
 * 短い名前と正式名称の両方を持たせ、幅に応じて出し分ける。
 */
/*
 * アイコンは外部ライブラリを持たず、24pxグリッドの線画をここに直接書く。
 * 院内から外部CDNへ出られない環境でも欠けないようにするため。
 * 施設が増えたらここに1行足す。
 */
const BUILDING = '<path d="M5 21V6a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v15"/><path d="M3 21h18"/>';

const items = [
	{
		href: '',
		short: '全体',
		full: '全体画面',
		icon: `<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
			<rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>`,
	},
	{
		href: 'kyoritsu',
		short: '共立',
		full: '戸畑共立病院',
		icon: `${BUILDING}<path d="M12 9v6M9 12h6"/>`,
	},
	{
		href: 'reha',
		short: 'リハ',
		full: '戸畑リハビリテーション病院',
		icon: `${BUILDING}<path d="M8 13h2l1.5-3.5L13.5 16 15 13h1"/>`,
	},
	{
		href: 'ayame',
		short: 'あやめ',
		full: 'あやめの里',
		icon: '<path d="M3 11 12 4l9 7"/><path d="M6 10v10h12V10"/>',
	},
	{
		href: 'meijimachi',
		short: '明治町',
		full: '明治町クリニック',
		icon: '<circle cx="12" cy="12" r="8"/><path d="M12 8.5v7M8.5 12h7"/>',
	},
];

const normalize = (path: string) => path.replace(/\/+$/, '');
const current = normalize(Astro.url.pathname);
---

<button
	type="button"
	class="app-nav-toggle"
	aria-controls="app-nav"
	aria-expanded="false"
	aria-label="メニューを開く"
>
	<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
		<path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
	</svg>
</button>

<nav id="app-nav" class="app-nav" aria-label="施設メニュー">
	<ul class="app-nav__list">
		{
			items.map((item) => {
				const href = withBase(item.href);
				const isCurrent = normalize(href) === current;
				return (
					<li>
						<a
							class="app-nav__item"
							href={href}
							title={item.full}
							aria-label={item.full}
							aria-current={isCurrent ? 'page' : undefined}
						>
							<svg
								class="app-nav__icon"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="1.8"
								stroke-linecap="round"
								stroke-linejoin="round"
								aria-hidden="true"
								set:html={item.icon}
							/>
							<span class="app-nav__short">{item.short}</span>
							<span class="app-nav__full">{item.full}</span>
						</a>
					</li>
				);
			})
		}
	</ul>
</nav>

<script>
	// 狭い画面のときだけ意味を持つ開閉。広い画面では常に開いた状態なので何もしない。
	const toggle = document.querySelector<HTMLButtonElement>('.app-nav-toggle');
	const nav = document.getElementById('app-nav');

	if (toggle && nav) {
		const setOpen = (open: boolean) => {
			nav.classList.toggle('is-open', open);
			toggle.setAttribute('aria-expanded', String(open));
			toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
		};

		toggle.addEventListener('click', () => setOpen(!nav.classList.contains('is-open')));

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});

		// 外側を触ったら閉じる。ボタン自身の click は先に処理されるのでここでは除外する。
		document.addEventListener('click', (event) => {
			const target = event.target;
			if (!(target instanceof Node)) return;
			if (nav.contains(target) || toggle.contains(target)) return;
			setOpen(false);
		});
	}
</script>

<style>
	.app-nav {
		position: fixed;
		top: 0;
		bottom: 0;
		left: 0;
		z-index: 20;
		box-sizing: border-box;
		width: var(--app-sidebar-width);
		padding: var(--app-header-height) 8px;
		/* パネルと面する辺だけ赤で区切る。帯と分割グリッドの境目を明示する */
		border-right: 1px solid var(--app-nav-edge);
		background: rgba(250, 250, 250, 0.96);
		backdrop-filter: blur(8px);
	}

	.app-nav__list {
		display: flex;
		flex-direction: column;
		gap: 4px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/*
	 * アイコンだけだと、どちらも病院で見分けが付かない。
	 * 2文字の短い名前を下に添えて、遠目でも取り違えないようにする。
	 */
	.app-nav__item {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 2px;
		box-sizing: border-box;
		min-height: 52px;
		border-radius: var(--panel-radius);
		color: #526070;
		font-size: 11px;
		font-weight: 700;
		line-height: 1.2;
		text-align: center;
		text-decoration: none;
	}

	.app-nav__icon {
		display: block;
		width: 22px;
		height: 22px;
	}

	@media (hover: hover) {
		.app-nav__item:hover {
			background: var(--panel-surface);
			color: #0a0a0a;
		}
	}

	.app-nav__item:focus-visible {
		outline: 2px solid #0a0a0a;
		outline-offset: -2px;
	}

	/* 今どこを見ているかは色だけに頼らず、下線でも示す */
	.app-nav__item[aria-current='page'] {
		background: var(--panel-surface);
		color: #0a0a0a;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* 幅64pxの帯には正式名称が入らない。短い名前だけを出す */
	.app-nav__full {
		display: none;
	}

	.app-nav-toggle {
		display: none;
	}

	/*
	 * 狭い画面では帯を畳む。--app-sidebar-width が 0 になるので、
	 * ヘッダー・フッター・メインは自動で左端まで戻る。
	 */
	@media (max-width: 600px) {
		.app-nav {
			top: var(--app-header-height);
			bottom: auto;
			width: auto;
			min-width: 200px;
			padding: 8px;
			/* 畳んだ状態ではパネルと面するのは右と下の2辺になる */
			border-right: 1px solid var(--app-nav-edge);
			border-bottom: 1px solid var(--app-nav-edge);
			border-bottom-right-radius: var(--panel-radius);
			/* visibility でタブ移動の対象からも外す。display:none だと動きが付けられない */
			visibility: hidden;
			opacity: 0;
			transform: translateY(-4px);
			transition:
				opacity 160ms ease,
				transform 160ms ease,
				visibility 160ms;
		}

		.app-nav.is-open {
			visibility: visible;
			opacity: 1;
			transform: none;
		}

		/* 畳んだ側は幅に余裕がある。アイコンの横に正式名称を並べる */
		.app-nav__item {
			flex-direction: row;
			justify-content: flex-start;
			gap: 10px;
			padding: 0 12px;
			font-size: 15px;
			text-align: left;
		}

		.app-nav__short {
			display: none;
		}

		.app-nav__full {
			display: inline;
		}

		.app-nav-toggle {
			position: fixed;
			top: 0;
			left: 0;
			z-index: 30;
			display: flex;
			align-items: center;
			justify-content: center;
			width: var(--app-header-height);
			height: var(--app-header-height);
			padding: 0;
			border: 0;
			background: transparent;
			color: #0a0a0a;
			cursor: pointer;
		}

		.app-nav-toggle:focus-visible {
			outline: 2px solid #0a0a0a;
			outline-offset: -2px;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.app-nav {
			transition: none;
		}
	}
</style>
