---
import { withBase } from '../lib/base-url';
import { boardDateId, boardStatusId, type KpiBoardItem } from '../lib/facility-board';

type Props = {
	sourceId: string;
	label: string;
	items: KpiBoardItem[];
	href?: string;
};

const { sourceId, label, items, href } = Astro.props;
const Root = href ? 'a' : 'section';
const rootProps = href ? { href: withBase(href), 'aria-label': `${label}を開く` } : {};
---

<Root class:list={['kpi', { 'kpi--linked': href }]} aria-live="polite" {...rootProps}>
	<h1 class="label">{label}</h1>

	<dl class="kpi-grid">
		{
			items.map((item) => (
				<div class:list={['kpi-row', { 'kpi-row--primary': item.isPrimary }]}>
					<dt>{item.label}</dt>
					<dd id={item.id} class:list={[{ value: item.isPrimary }]}>
						取得中...
					</dd>
					{
						item.chart && (
							<svg
								id={item.chart.id}
								class="trend-chart"
								viewBox="0 0 320 120"
								preserveAspectRatio="xMidYMid meet"
								role="img"
								aria-label={item.chart.ariaLabel}
							/>
						)
					}
				</div>
			))
		}
	</dl>

	<p id={boardDateId(sourceId)} class="date">日付: --</p>
	<p id={boardStatusId(sourceId)} class="status">APIから最新データを取得しています</p>
</Root>

<style>
	.kpi {
		position: relative;
		display: block;
		box-sizing: border-box;
		width: 100%;
		border-radius: 4pt;
		color: inherit;
		text-align: center;
		text-decoration: none;
		transition: background-color 160ms ease;
	}

	.label,
	.date,
	.status {
		margin: 0;
		color: #526070;
	}

	.label {
		font-size: 18px;
		font-weight: 700;
	}

	.kpi-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		align-items: start;
		gap: 24px;
		padding: 24px;
	}

	.kpi-row {
		align-self: stretch;
		background: #efefef;
		border-radius: 4pt;
		padding: 12px 6px;
	}

	.kpi-row--primary {
		grid-column: 1 / -1;
		background: transparent;
		padding: 0;
	}

	.kpi--linked {
		cursor: pointer;
	}

	.kpi--linked:hover,
	.kpi--linked:focus-visible {
		background: #f0f2f4;
	}

	.kpi--linked:focus-visible {
		outline: 3px solid #0a0a0a;
		outline-offset: 4px;
	}

	dt {
		font-size: 18px;
		font-weight: 700;
		line-height: 1.4;
	}

	dd {
		margin: 6px 0 0;
		font-size: 24px;
		font-weight: 700;
		line-height: 1.2;
	}

	.value {
		margin: 24px 0;
		font-size: clamp(64px, 16vw, 160px);
		font-weight: 800;
		line-height: 1;
	}

	.date {
		font-size: 16px;
	}

	.status {
		margin-top: 8px;
		font-size: 14px;
	}

	.trend-chart {
		display: block;
		width: 100%;
		height: auto;
		margin-top: 8px;
	}

	/* D3が実行時にsvg内へ生成する要素にはscoped属性が付かないため:global()が必要 */
	:global(.trend-chart-empty) {
		fill: #526070;
		font-size: 12px;
	}

	:global(.trend-y-tick) {
		stroke: #526070;
		stroke-width: 1;
	}

	:global(.trend-y-label),
	:global(.trend-x-label) {
		fill: #526070;
		font-size: 8px;
	}

	:global(.trend-line) {
		fill: none;
		stroke: #0a0a0a;
		stroke-width: 2;
	}

	:global(.trend-point) {
		fill: #0a0a0a;
		cursor: pointer;
	}

	:global(.trend-missing line) {
		stroke: #c0392b;
		stroke-width: 1.5;
	}
</style>
